---
interface Props {
  title: string;
  oneLiner: string;
  description: string;
  audience?: string[];
  deliverables?: string[];
  domains?: string[];
  modules?: { name: string; desc: string }[];
  pricingNote: string;
  disclaimer?: string;
  ctaText: string;
  ctaHref: string;
  accentColor?: string;
  showPayButton?: boolean;
  payAmount?: number;
  payServiceId?: string;
}

const {
  title,
  oneLiner,
  description,
  audience,
  deliverables,
  domains,
  modules,
  pricingNote,
  disclaimer,
  ctaText,
  ctaHref,
  accentColor = "#8A2BE2",
  showPayButton = false,
  payAmount,
  payServiceId,
} = Astro.props;
---

<div
  class="service-card relative p-8 sm:p-10 rounded-2xl border border-charcoal-light/10 bg-[#0f1117] mb-8"
  style={`opacity:0; transform:translateY(20px); border-left: 3px solid ${accentColor};`}
>
  <!-- Title Block -->
  <h3 class="font-poppins text-xl sm:text-2xl font-bold text-offwhite mb-2">{title}</h3>
  <p class="font-lora text-sm italic mb-6" style={`color: ${accentColor};`}>{oneLiner}</p>

  <!-- Description -->
  <div class="font-lora text-sm text-muted leading-relaxed mb-8 max-w-3xl whitespace-pre-line">
    {description}
  </div>

  <!-- Modules (for workshops) -->
  {modules && modules.length > 0 && (
    <div class="mb-8">
      <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted/60 block mb-4">Available Modules</span>
      <div class="grid sm:grid-cols-2 gap-3">
        {modules.map((m) => (
          <div class="p-4 rounded-xl border border-charcoal-light/15 bg-charcoal-dark/30">
            <h5 class="font-poppins text-xs font-semibold text-offwhite mb-1">{m.name}</h5>
            <p class="font-lora text-[11px] text-muted leading-relaxed">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Domains covered -->
  {domains && domains.length > 0 && (
    <div class="mb-8">
      <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted/60 block mb-3">Domains Covered</span>
      <div class="flex flex-wrap gap-2">
        {domains.map((d) => (
          <span class="font-mono text-[10px] px-3 py-1.5 rounded-full border border-charcoal-light/20 text-muted bg-charcoal-dark/30">
            {d}
          </span>
        ))}
      </div>
    </div>
  )}

  <!-- Two columns: Audience + Deliverables -->
  <div class="grid sm:grid-cols-2 gap-8 mb-8">
    {audience && audience.length > 0 && (
      <div>
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted/60 block mb-3">Who This Is For</span>
        <ul class="space-y-2">
          {audience.map((a) => (
            <li class="flex items-start gap-2 text-sm text-muted font-lora leading-relaxed">
              <span class="mt-1 shrink-0" style={`color: ${accentColor};`}>→</span>
              <span>{a}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
    {deliverables && deliverables.length > 0 && (
      <div>
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted/60 block mb-3">What You Get</span>
        <ul class="space-y-2">
          {deliverables.map((d) => (
            <li class="flex items-start gap-2 text-sm text-muted font-lora leading-relaxed">
              <span class="mt-1 shrink-0" style={`color: ${accentColor};`}>→</span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Pricing -->
  <div class="flex flex-wrap items-center gap-4 mb-6 p-4 rounded-xl border border-charcoal-light/10 bg-charcoal-dark/20">
    <svg class="w-4 h-4 text-muted/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span class="font-lora text-xs text-muted italic">{pricingNote}</span>
  </div>

  <!-- Disclaimer -->
  {disclaimer && (
    <div class="mb-6 p-3 rounded-lg border border-yellow-500/15 bg-yellow-500/5">
      <p class="font-mono text-[10px] text-yellow-400/80 leading-relaxed">{disclaimer}</p>
    </div>
  )}

  <!-- CTA -->
  <div class="flex flex-wrap items-center gap-4">
    <a
      href={ctaHref}
      class="inline-flex items-center gap-2 font-poppins text-xs font-semibold uppercase tracking-widest px-6 py-3 rounded-lg transition-all duration-300 hover:translate-y-[-2px]"
      style={`color: ${accentColor}; border: 1px solid ${accentColor}40; background: ${accentColor}10;`}
    >
      {ctaText}
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
    {showPayButton && payAmount && (
      <a
        href={`https://razorpay.me/@kinbotechnologies?amount=${payAmount * 100}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-poppins text-xs font-semibold uppercase tracking-widest px-6 py-3 rounded-lg bg-teal text-charcoal-dark transition-all duration-300 hover:translate-y-[-2px] hover:shadow-lg hover:shadow-teal/20"
      >
        Pay ₹{payAmount}
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    )}
  </div>
</div>
