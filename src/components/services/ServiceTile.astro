---
interface Props {
  title: string;
  tagline: string;
  bullets: string[];
  ctaText: string;
  ctaHref: string;
  accentColor: string;
  icon: string;
}

const { title, tagline, bullets, ctaText, ctaHref, accentColor, icon } = Astro.props;
---

<div
  class="service-tile group relative p-8 rounded-2xl border border-charcoal-light/10 bg-[#0f1117] hover:bg-[#13161f] transition-all duration-500"
  style={`opacity:0; transform:translateY(24px); border-left: 3px solid ${accentColor};`}
>
  <!-- Icon -->
  <div
    class="w-14 h-14 rounded-xl flex items-center justify-center mb-6 transition-colors duration-300"
    style={`background: ${accentColor}12; border: 1px solid ${accentColor}30;`}
  >
    <svg class="w-6 h-6" fill="none" stroke={accentColor} viewBox="0 0 24 24" stroke-width="1.5">
      <Fragment set:html={icon} />
    </svg>
  </div>

  <!-- Title -->
  <h3 class="font-poppins text-2xl font-bold text-offwhite mb-2">{title}</h3>

  <!-- Tagline -->
  <p class="font-lora text-sm italic text-muted mb-6">{tagline}</p>

  <!-- Bullets -->
  <ul class="space-y-3 mb-8">
    {bullets.map((b) => (
      <li class="flex items-start gap-3 text-sm text-muted font-lora leading-relaxed">
        <span class="mt-1 shrink-0" style={`color: ${accentColor};`}>→</span>
        <span>{b}</span>
      </li>
    ))}
  </ul>

  <!-- CTA -->
  <a
    href={ctaHref}
    class="inline-flex items-center gap-2 font-poppins text-xs font-semibold uppercase tracking-widest px-6 py-3 rounded-lg transition-all duration-300"
    style={`color: ${accentColor}; border: 1px solid ${accentColor}40; background: ${accentColor}08;`}
  >
    {ctaText}
    <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </a>
</div>
