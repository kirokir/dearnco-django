---
import { ViewTransitions } from "astro:transitions";
import Preloader from "../components/Preloader.astro";
import { supabaseAdmin } from "../lib/supabase";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Arjun Jayesh — Polymath · Engineer · Researcher",
  description = "Portfolio of Arjun Jayesh — Systems Architect, Independent Researcher, and Developer building deterministic, constraint-bound systems.",
} = Astro.props;

const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Products", href: "/products" },
  { label: "Services", href: "/services", dropdown: [
    { label: "Kinbo Cares", href: "/services/cares", desc: "Product Support" },
    { label: "Kinbo Expert", href: "/services/expert", desc: "Knowledge Services" },
    { label: "Kinbo Consultancy", href: "/services/consultancy", desc: "Technical Advisory" },
  ]},
  { label: "Founder", href: "/founder" },
  { label: "Team", href: "/team" },
  { label: "Blog", href: "/blog" },
  { label: "Ideas", href: "/ideas" },
  { label: "Contact", href: "/chat" },
];

let enterpriseAssets = {
    logo_url: "",
    favicon_url: "/favicon.svg",
    company_name: "KINBO TECHNOLOGIES PRIVATE LIMITED"
};

if (supabaseAdmin) {
    try {
        const { data } = await supabaseAdmin.from('site_config').select('data').eq('key', 'enterprise_assets').single();
        if (data?.data) enterpriseAssets = { ...enterpriseAssets, ...data.data };
    } catch (e) {
        console.error("Layout SSR:", e);
    }
}

const rawWhatsappNum = enterpriseAssets.whatsapp_number || "+91 9846547132";
const whatsappMsg = enterpriseAssets.whatsapp_message || "hi kinbo , can you help me";
const cleanWhatsappNumber = rawWhatsappNum.replace(/[^0-9]/g, '');
const whatsappUrl = `https://wa.me/${cleanWhatsappNumber}?text=${encodeURIComponent(whatsappMsg)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Title & Description (pages should use SEOHead component for overrides) -->
    <title>{title} — KINBO TECHNOLOGIES PRIVATE LIMITED</title>
    <meta name="description" content={description} />
    
    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="googled00f4fce4fdbf029" />
    
    <!-- Robots -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- OpenGraph -->
    <meta property="og:title" content={`${title} — KINBO TECHNOLOGIES PRIVATE LIMITED`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="KINBO TECHNOLOGIES PRIVATE LIMITED" />
    <meta property="og:locale" content="en_IN" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — KINBO TECHNOLOGIES PRIVATE LIMITED`} />
    <meta name="twitter:description" content={description} />
    
    <!-- Canonical -->
    <link rel="canonical" href={Astro.url.href} />
    
    <!-- Favicon -->
    <link rel="icon" type={enterpriseAssets.favicon_url?.endsWith('.svg') ? 'image/svg+xml' : 'image/png'} href={enterpriseAssets.favicon_url || "/favicon.svg"} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://res.cloudinary.com" />
    <link rel="dns-prefetch" href="https://mwwvycnuyqfoscwizbhk.supabase.co" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    
    <!-- JSON-LD Slot (pages inject structured data here) -->
    <slot name="head" />
    
    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-89SJMNYKCV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-89SJMNYKCV');
    </script>
    
    <ViewTransitions />
  </head>
  <body>
    <!-- ─── Debug Banner ─── -->
    <div id="debug-banner" class="hidden fixed top-0 left-0 w-full z-[100] bg-red-600 text-white font-mono text-[10px] py-1 px-4 flex justify-between items-center">
      <span>SYSTEM_CRITICAL: <span id="debug-error-msg">Unknown Server Error</span></span>
      <button onclick="this.parentElement.classList.add('hidden')" class="hover:text-black">[DISMISS]</button>
    </div>

    <Preloader />
    <!-- ─── Top Utility Bar ─── -->
    <div class="fixed top-20 right-0 z-[70] p-4 flex items-center gap-6 bg-charcoal/50 backdrop-blur-sm rounded-l-xl border-l border-b border-t border-charcoal-light/30">
      <!-- Clock -->
      <div id="clock" class="font-mono text-xs text-teal tracking-widest tabular-nums">
        00:00:00
      </div>
      
      <!-- Theme Toggle -->
      <button 
        id="theme-toggle" 
        class="text-muted hover:text-teal transition-colors duration-300"
        aria-label="Toggle theme"
      >
        <svg id="sun-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <svg id="moon-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <!-- ─── Navbar ─── -->
    <nav
      class="fixed top-0 left-0 w-full z-50 backdrop-blur-md bg-charcoal/80 border-b border-charcoal-light/40"
      id="main-nav"
    >
      <div class="max-w-7xl mx-auto flex items-center justify-between px-5 py-4">
        <!-- Logo -->
        <a
          href="/"
          data-astro-reload
          class="flex items-center gap-3 font-poppins text-2xl font-bold text-teal hover:text-offwhite transition-colors duration-300 group"
          aria-label="Go to home"
        >
          <div class="w-8 h-8 bg-teal/10 rounded flex items-center justify-center group-hover:bg-teal/20 transition-all border border-teal/20 overflow-hidden">
            {enterpriseAssets.logo_url ? (
                <img src={enterpriseAssets.logo_url} alt="Logo" class="w-full h-full object-contain" />
            ) : (
                <span class="text-teal font-mono text-sm">K</span>
            )}
          </div>
          <span class="tracking-widest">{enterpriseAssets.company_name?.split(' ')[0] || "KINBO"}</span>
        </a>

        <!-- Desktop Nav Links -->
        <ul class="hidden md:flex items-center gap-8 list-none m-0 p-0">
          {navLinks.map((link) => (
            <li class={link.dropdown ? 'relative group' : ''}>
              <a
                href={link.href}
                class="nav-link font-poppins text-sm font-medium uppercase tracking-widest text-muted hover:text-offwhite transition-colors duration-300 relative pb-1 flex items-center gap-1"
              >
                {link.label}
                {link.dropdown && (
                  <svg class="w-3 h-3 opacity-50 group-hover:opacity-100 transition-all group-hover:rotate-180 duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>
              {link.dropdown && (
                <div class="services-dropdown absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                  <div class="w-64 rounded-xl border border-charcoal-light/30 bg-charcoal/95 backdrop-blur-xl shadow-2xl overflow-hidden">
                    <div class="p-2">
                      {link.dropdown.map((sub: any) => (
                        <a
                          href={sub.href}
                          class="flex flex-col gap-0.5 px-4 py-3 rounded-lg hover:bg-teal/5 transition-colors group/item"
                        >
                          <span class="font-poppins text-xs font-semibold text-offwhite group-hover/item:text-teal transition-colors">{sub.label}</span>
                          <span class="font-mono text-[9px] text-muted/60 uppercase tracking-widest">{sub.desc}</span>
                        </a>
                      ))}
                    </div>
                    <div class="border-t border-charcoal-light/20 px-4 py-2.5">
                      <a href="/services" class="font-mono text-[9px] text-teal/60 uppercase tracking-widest hover:text-teal transition-colors">View All Services →</a>
                    </div>
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>

      </div>
    </nav>

    <!-- ─── Main Content ─── -->
    <main>
      <slot />
    </main>

    <!-- Mobile Nav Bar (Bottom Floating Island) -->
    <nav
      class="md:hidden fixed bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-6 px-6 py-3 rounded-full bg-charcoal/80 backdrop-blur-md border border-charcoal-light/30 shadow-2xl z-50 pointer-events-auto"
      aria-label="Mobile navigation"
    >
      {navLinks.filter(link => ["Home", "Products", "Services", "Team", "Contact"].includes(link.label)).map((link) => {
        // Icon mapping based on label
        let iconSvg = "";
        if (link.label === "Home") iconSvg = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>`;
        else if (link.label === "Products") iconSvg = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>`;
        else if (link.label === "Services") iconSvg = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`;
        else if (link.label === "Team") iconSvg = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>`;
        else if (link.label === "Chat" || link.label === "Contact") iconSvg = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`;

        return (
          <a
            href={link.href}
            class="mobile-nav-link text-muted hover:text-teal transition-colors duration-300 relative p-1"
            aria-label={link.label}
          >
            <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconSvg}></svg>
          </a>
        )
      })}
    </nav>

    <!-- ─── Footer ─── -->
    <footer class="premium-footer">
      <div class="footer-inner">
        <div class="footer-left">
          <p class="footer-contact-title">IN CASE YOU NEED ANY CLARIFICATION, YOU MAY CONTACT OUR TEAM:</p>
          <a href="/chat" class="footer-cta-btn">Start a Conversation →</a>
          <br />
          <p class="footer-contact-detail">{enterpriseAssets.company_name || "KINBO TECHNOLOGIES PRIVATE LIMITED"}</p>
          <p class="footer-contact-address">INDIA | CHINA | GCC</p>
          
          <p class="footer-copyright">
            © {new Date().getFullYear()} Kinbo Technologies Private Limited. All rights reserved.
          </p>
        </div>

        <div class="footer-right">
          <div class="footer-hero-text">
            <span class="text-orange">KINBO TECHNOLOGIES</span><br />
            <span class="text-orange">INNOVATION AND</span><br />
            <span class="text-white font-outline">GREAT IDEAS</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- ─── Global Scripts ─── -->
    <script>
      function initLayout() {
        // --- Clock ---
        const clockEl = document.getElementById("clock");
        function updateClock() {
          const now = new Date();
          const h = String(now.getHours()).padStart(2, '0');
          const m = String(now.getMinutes()).padStart(2, '0');
          const s = String(now.getSeconds()).padStart(2, '0');
          if (clockEl) clockEl.textContent = `${h}:${m}:${s}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // --- Theme Toggle ---
        const toggle = document.getElementById("theme-toggle");
        const sun = document.getElementById("sun-icon");
        const moon = document.getElementById("moon-icon");
        const html = document.documentElement;

        function setTheme(theme: string) {
          html.setAttribute("data-theme", theme);
          localStorage.setItem("theme", theme);
          if (theme === "light") {
            sun?.classList.remove("hidden");
            moon?.classList.add("hidden");
          } else {
            sun?.classList.add("hidden");
            moon?.classList.remove("hidden");
          }
        }

        const savedTheme = localStorage.getItem("theme") || "dark";
        setTheme(savedTheme);

        toggle?.addEventListener("click", () => {
          const current = html.getAttribute("data-theme");
          setTheme(current === "light" ? "dark" : "light");
        });

        // --- Mobile nav active state updates ---
        // Active states are purely CSS now using the same Intersection Observer logic 
        // as the desktop nav for anchors. For SPA routes, page-load handles it.

        // --- Active link tracking (only for current page anchors) ---
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link, .mobile-nav-link");

        if (sections.length > 0 || navLinks.length > 0) {
          // Add basic SPA route active state checking to handle non-anchor links
          const currentPath = window.location.pathname;
          navLinks.forEach((link) => {
            link.classList.remove("active");
            const href = link.getAttribute("href");
            if (href === currentPath || (href === "/" && currentPath === "")) {
               link.classList.add("active");
            }
          });

          // Handle in-page anchors
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  navLinks.forEach((link) => {
                    link.classList.remove("active");
                    const href = link.getAttribute("href");
                    if (href === `#${entry.target.id}` || (href === "/" && entry.target.id === "home")) {
                      link.classList.add("active");
                    }
                  });
                }
              });
            },
            { rootMargin: "-40% 0px -55% 0px" }
          );
          sections.forEach((section) => observer.observe(section));
        }
      }

      // --- Debug Mode & Health Check ---
      async function runHealthCheck() {
        try {
          const res = await fetch('/api/config');
          if (!res.ok) {
            const data = await res.json();
            const banner = document.getElementById('debug-banner');
            const msg = document.getElementById('debug-error-msg');
            if (banner && msg) {
               msg.textContent = `${res.status} ${data.message || res.statusText}`;
               banner.classList.remove('hidden');
            }
            console.error('Health Check Failed:', data);
          }
        } catch (e) {
          console.error('Health Check Network Error:', e);
        }
      }

      document.addEventListener('astro:page-load', () => {
        initLayout();
        // Only run health check if debug requested or on dev
        if (window.location.search.includes('debug=true') || window.location.hostname === 'localhost') {
           runHealthCheck();
        }
      });
    </script>

    <!-- ─── Nav Active Style ─── -->
    <style is:global>
      .nav-link.active,
      .nav-link:hover {
        color: var(--color-offwhite) !important;
      }
      .nav-link.active::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        border-bottom: 2px dashed var(--color-teal);
      }
      
      .mobile-nav-link.active {
        color: var(--color-teal) !important;
      }
      .mobile-nav-link.active::after {
        content: "";
        position: absolute;
        bottom: -4px;
        left: 50%;
        transform: translateX(-50%);
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background-color: var(--color-teal);
      }

      /* Premium image-based layout footer styling */
      .premium-footer {
        position: relative;
        background: linear-gradient(to right, rgba(10, 10, 12, 0.97) 35%, rgba(249, 115, 22, 0.1) 75%, rgba(10, 10, 12, 0.97) 100%), url('/footer_bg_crowd.png');
        background-size: cover;
        background-position: center;
        border-top: 1.5px solid rgba(255, 255, 255, 0.05);
        padding: 96px 28px 72px 28px;
        color: #f0f0ec;
        margin-top: auto;
      }
      .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 40px;
        align-items: center;
      }
      @media (max-width: 768px) {
        .footer-inner {
          grid-template-columns: 1fr;
          gap: 48px;
        }
      }
      .footer-left {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .footer-contact-title {
        font-family: 'Roboto Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(240, 240, 236, 0.40);
        margin-bottom: 24px;
        line-height: 1.5;
      }
      .footer-contact-detail {
        font-family: 'Syne', sans-serif;
        font-size: clamp(16px, 2vw, 20px);
        font-weight: 800;
        letter-spacing: -0.5px;
        color: rgba(240, 240, 236, 0.85);
        line-height: 1.25;
        margin-bottom: 4px;
      }
      .footer-contact-address {
        font-family: 'Roboto Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.12em;
        color: rgba(240, 240, 236, 0.35);
        text-transform: uppercase;
        margin-top: 6px;
      }
      .footer-copyright {
        font-family: 'Roboto Mono', monospace;
        font-size: 9px;
        color: rgba(240, 240, 236, 0.22);
        letter-spacing: 0.05em;
        margin-top: 48px;
      }
      .footer-right {
        display: flex;
        justify-content: flex-end;
      }
      @media (max-width: 768px) {
        .footer-right {
          justify-content: flex-start;
        }
      }
      .footer-hero-text {
        font-family: 'Syne', sans-serif;
        font-size: clamp(28px, 4vw, 48px);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -1.5px;
        text-align: right;
      }
      @media (max-width: 768px) {
        .footer-hero-text {
          text-align: left;
        }
      }
      .text-orange {
        color: #f97316;
      }
      .font-outline {
        color: transparent;
        -webkit-text-stroke: 1px rgba(240, 240, 236, 0.85);
      }
      .footer-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Syne', sans-serif;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-teal, #2dd4bf);
        border: 0.5px solid rgba(45, 212, 191, 0.25);
        background: rgba(45, 212, 191, 0.05);
        padding: 8px 16px;
        border-radius: 4px;
        text-decoration: none;
        width: fit-content;
        margin-top: 12px;
        margin-bottom: 8px;
        transition: all 0.2s ease;
      }
      .footer-cta-btn:hover {
        background: rgba(45, 212, 191, 0.12);
        border-color: var(--color-teal, #2dd4bf);
        color: #fff;
      }
      
      /* WhatsApp Floating Widget */
      .whatsapp-widget {
        position: fixed;
        z-index: 99;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background-color: #25d366;
        box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
        color: #fff;
        text-decoration: none;
      }
      .whatsapp-widget:hover {
        transform: scale(1.1) translateY(-2px);
        box-shadow: 0 8px 24px rgba(37, 211, 102, 0.6);
      }
      .whatsapp-widget svg {
        width: 28px;
        height: 28px;
        fill: currentColor;
      }
      @media (max-width: 768px) {
        .whatsapp-widget {
          bottom: 96px;
          right: 20px;
        }
      }
      @media (min-width: 769px) {
        .whatsapp-widget {
          bottom: 32px;
          right: 32px;
        }
      }
    </style>
    
    <!-- WhatsApp Floating Widget -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-widget"
      aria-label="Chat on WhatsApp"
