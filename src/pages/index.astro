---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { supabaseAdmin } from "../lib/supabase";

let enterpriseAssets = {
    hero_video_url: "https://assets.mixkit.co/videos/preview/mixkit-digital-animation-of-a-circuit-board-1113-large.mp4",
    logo_url: "",
    locations: "INDIA | CHINA | GCC",
    company_name: "KINBO TECHNOLOGIES PRIVATE LIMITED"
};

if (supabaseAdmin) {
    try {
        const { data, error } = await supabaseAdmin
            .from('site_config')
            .select('data')
            .eq('key', 'enterprise_assets')
            .single();
        
        if (error && error.code !== 'PGRST116') {
            console.error('Homepage Data Fetch Error:', error);
        } else if (data?.data) {
            enterpriseAssets = { ...enterpriseAssets, ...data.data };
        }
    } catch (e) {
        console.error('Homepage SSR Crash Caught:', e);
        // Fallback already defined in enterpriseAssets variable
    }
} else {
    console.warn('Supabase client not available on homepage SSR');
}
---

<Layout title="Home" description="KINBO TECHNOLOGIES PRIVATE LIMITED builds intelligent everyday applications that combine practical technology with user-focused design. Enterprise software, AI systems, healthcare technology, and research infrastructure.">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&display=swap" rel="stylesheet" slot="head" />
  
  <!-- Organization + WebSite JSON-LD -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "KINBO TECHNOLOGIES PRIVATE LIMITED",
      "alternateName": "Kinbo Technologies",
      "url": "https://portfolio-sage-two-43.vercel.app",
      "logo": enterpriseAssets.logo_url || "https://portfolio-sage-two-43.vercel.app/favicon.svg",
      "description": "KINBO TECHNOLOGIES builds intelligent everyday applications combining practical technology with user-focused design. Specializing in enterprise software, AI systems, healthcare technology, and research infrastructure.",
      "founder": {
        "@type": "Person",
        "name": "Arjun Jayesh",
        "jobTitle": "Founder & Systems Architect",
        "url": "https://portfolio-sage-two-43.vercel.app/founder"
      },
      "foundingDate": "2024",
      "areaServed": ["India", "China", "GCC"],
      "knowsAbout": ["Artificial Intelligence", "Healthcare Technology", "Enterprise Software", "Computer Vision", "RAG Systems", "Clinical Workflow Optimization", "Research Infrastructure"],
      "sameAs": ["https://dear.is-a.dev/", "https://dearnco.is-a.dev/"]
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "KINBO TECHNOLOGIES",
      "url": "https://portfolio-sage-two-43.vercel.app",
      "publisher": {
        "@type": "Organization",
        "name": "KINBO TECHNOLOGIES PRIVATE LIMITED"
      }
    }
  ])} />
  
  <div class="ks-page">
    <!-- Startup Animation Overlay -->
    <div id="startup-overlay" class="fixed inset-0 z-[100] bg-charcoal hidden flex-col items-center justify-center overflow-hidden">
    <div class="relative">
      <div id="startup-logo" class="w-24 h-24 bg-teal/10 rounded-2xl border border-teal/20 flex items-center justify-center mb-8 scale-0 overflow-hidden">
        {enterpriseAssets.logo_url ? (
            <img src={enterpriseAssets.logo_url} alt="Logo" class="w-full h-full object-contain" />
        ) : (
            <span class="text-teal font-poppins text-4xl font-bold">K</span>
        )}
      </div>
      <div id="startup-bar" class="absolute -bottom-4 left-0 w-0 h-px bg-teal shadow-[0_0_10px_rgba(42,157,143,0.8)]"></div>
    </div>
    <div id="startup-text" class="font-mono text-[10px] text-teal uppercase tracking-[0.5em] opacity-0 translate-y-4">
      Initializing Kinbo Systems
    </div>
  </div>

  <!-- Hero Section with Video Parallax -->
  <section class="relative min-h-screen flex items-center justify-start overflow-hidden" id="hero">
    <!-- Parallax Background Container -->
    <div class="absolute inset-0 z-0 scale-110" id="hero-video-container"
         data-parallax={enterpriseAssets.hero_parallax_intensity ?? 20}>
      <div class="absolute inset-0 bg-charcoal-dark z-10 pointer-events-none"
           style={`opacity: ${enterpriseAssets.hero_bg_darkness ?? 0.3};`}></div>
      {(!enterpriseAssets.hero_bg_type || enterpriseAssets.hero_bg_type === 'video') && enterpriseAssets.hero_video_url?.match(/\.(mp4|webm|mov|ogg)$/i) ? (
        <video 
          autoplay 
          muted 
          loop 
          playsinline 
          class="w-full h-full object-cover"
          style={`filter: blur(${enterpriseAssets.hero_bg_blur ?? 0}px); opacity: ${enterpriseAssets.hero_bg_opacity ?? 1};`}
        >
          <source src={enterpriseAssets.hero_video_url} type="video/mp4" />
        </video>
      ) : (
        <img 
          src={enterpriseAssets.hero_video_url}
          alt="Hero Background"
          class="w-full h-full object-cover"
          style={`filter: blur(${enterpriseAssets.hero_bg_blur ?? 0}px); opacity: ${enterpriseAssets.hero_bg_opacity ?? 1};`}
        />
      )}
    </div>

    <div class="relative z-20 max-w-7xl mx-auto px-6 lg:px-12 w-full text-left">
      <div class="max-w-4xl">
        <span class="font-mono text-[10px] md:text-xs text-teal uppercase tracking-[0.2em] md:tracking-[0.5em] block mb-4 md:mb-6 hero-anim opacity-0 translate-y-8 break-words">
          {enterpriseAssets.company_name}
        </span>
        <h1 class="hero-title-syne text-offwhite mb-6 md:mb-8 hero-anim opacity-0 translate-y-8 break-words" style="font-size: clamp(1.5rem, 5vw, 4.5rem); line-height: 1.1;">
          Intelligent technology<br/>
          <span class="text-teal">for real outcomes.</span>
        </h1>
        <p class="font-lora text-base sm:text-lg md:text-xl text-offwhite/90 max-w-2xl leading-relaxed mb-10 hero-anim opacity-0 translate-y-8">
          We focus on usable technology that improves outcomes rather than adding complexity. Intelligent everyday apps that combine practical technology with user-focused design.
        </p>
        <div class="flex flex-wrap gap-4 justify-start hero-anim opacity-0 translate-y-8 relative z-50 pointer-events-auto">
          <a href="/showcase" data-astro-reload class="px-8 py-4 bg-teal text-charcoal font-poppins font-bold uppercase tracking-widest text-sm rounded-full hover:shadow-[0_0_30px_rgba(42,157,143,0.4)] transition-all relative z-50 pointer-events-auto">
            Explore Products
          </a>
          <a href="/about" data-astro-reload class="px-8 py-4 border-2 border-teal/50 text-teal font-poppins font-bold uppercase tracking-widest text-sm rounded-full hover:bg-teal/10 hover:border-teal transition-all relative z-50 pointer-events-auto">
            Our Philosophy
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-6 lg:left-12 flex flex-col items-start gap-3 text-muted z-20 hero-anim opacity-0">
      <div class="w-12 h-px bg-gradient-to-r from-teal to-transparent opacity-80"></div>
      <span class="font-mono text-[9px] tracking-[0.3em] uppercase opacity-50">Scroll</span>
    </div>
  </section>

  <!-- Products Preview Section (Simplified version for quick loading) -->
  <section class="section-padding max-w-7xl mx-auto px-6" id="products-preview">
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      <div class="reveal p-10 rounded-3xl border border-[var(--ks-border)] bg-[rgba(255,255,255,0.01)] hover:border-teal/30 hover:bg-teal/[0.01] transition-all group overflow-hidden relative">
        <div class="absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity">
            <svg class="w-32 h-32 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="card-title-syne text-2xl text-offwhite mb-4">Glowup</h3>
        <p class="font-lora text-muted mb-8 text-sm leading-relaxed">Understanding skin health through image intelligence and structured progress tracking.</p>
        <a href="/products#glowup" class="text-teal font-mono text-xs uppercase tracking-widest hover:underline">View Product →</a>
      </div>

      <div class="reveal p-10 rounded-3xl border border-[var(--ks-border)] bg-[rgba(255,255,255,0.01)] hover:border-teal/30 hover:bg-teal/[0.01] transition-all group overflow-hidden relative">
        <div class="absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity">
            <svg class="w-32 h-32 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        </div>
        <h3 class="card-title-syne text-2xl text-offwhite mb-4">Relic</h3>
        <p class="font-lora text-muted mb-8 text-sm leading-relaxed">A digital multivendor marketplace empowering creators and students to reach global customers.</p>
        <a href="/products#relic" class="text-teal font-mono text-xs uppercase tracking-widest hover:underline">View Product →</a>
      </div>
    </div>
  </section>

  <!-- Enterprise Values Banner -->
  <section class="py-24 bg-charcoal-dark/30 border-y border-charcoal-light/10 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 text-center">
    <div class="flex flex-wrap justify-center gap-x-16 gap-y-12 items-center opacity-45">
        <div class="flex flex-col items-center gap-2">
            <span class="value-title-syne text-lg">PRACTICAL</span>
            <span class="font-mono text-[9px] tracking-widest text-teal">INNOVATION</span>
        </div>
        <div class="flex flex-col items-center gap-2">
            <span class="value-title-syne text-lg">USER</span>
            <span class="font-mono text-[9px] tracking-widest text-teal">TRANSPARENCY</span>
        </div>
        <div class="flex flex-col items-center gap-2">
            <span class="value-title-syne text-lg">CREATOR</span>
            <span class="font-mono text-[9px] tracking-widest text-teal">EMPOWERMENT</span>
        </div>
        <div class="flex flex-col items-center gap-2">
            <span class="value-title-syne text-lg">RESPONSIBLE</span>
            <span class="font-mono text-[9px] tracking-widest text-teal">TECHNOLOGY</span>
        </div>
    </div>
    </div>
  </section>

  </div>
</Layout>

<style>
  .ks-page {
    --ks-bg: #0a0a0c;
    --ks-surface: #0f1117;
    --ks-border: rgba(255, 255, 255, 0.07);
    --ks-text-primary: #f0f0ec;
    --ks-text-muted: rgba(240, 240, 236, 0.40);
    --ks-teal: #2dd4bf;
    background: var(--ks-bg);
    min-height: 100vh;
    color: var(--ks-text-primary);
  }
  .hero-title-syne {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    letter-spacing: -2px;
    text-transform: uppercase;
  }
  .card-title-syne {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }
  .value-title-syne {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    letter-spacing: -0.3px;
    text-transform: uppercase;
    color: var(--ks-text-primary);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initHome() {
    const overlay = document.getElementById("startup-overlay");
    const hasLoaded = sessionStorage.getItem("site_loaded");

    if (hasLoaded && overlay) {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      // Immediate hero entry if skip animation
      gsap.set(".hero-anim", { opacity: 1, y: 0 });
    } else if (overlay) {
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      // ─── Startup Timeline ───
      const startupTl = gsap.timeline();
      
      startupTl
        .to("#startup-logo", { scale: 1, duration: 1, ease: "back.out(1.7)" })
        .to("#startup-bar", { width: "100%", duration: 1.5, ease: "power2.inOut" }, "-=0.5")
        .to("#startup-text", { opacity: 1, y: 0, duration: 0.5 }, "-=1")
        .to("#startup-overlay", { 
            y: "-100%", 
            duration: 1, 
            ease: "power4.inOut", 
            delay: 0.5,
            onComplete: () => {
                sessionStorage.setItem("site_loaded", "true");
                overlay.classList.add("hidden");
                overlay.classList.remove("flex");
                // Hero entrance
                gsap.to(".hero-anim", {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    stagger: 0.2,
                    ease: "power3.out"
                });
            }
        });
    }

    // ─── Parallax Hero with dynamic intensity ───
    const parallaxContainer = document.getElementById("hero-video-container");
    const parallaxIntensity = parallaxContainer?.dataset?.parallax
        ? parseInt(parallaxContainer.dataset.parallax)
        : 20;

    gsap.to("#hero-video-container", {
      yPercent: parallaxIntensity,
      ease: "none",
      scrollTrigger: {
        trigger: "#hero",
        start: "top top",
        end: "bottom top",
        scrub: true
      }
    });

    // ─── Reveal Animations ───
    gsap.utils.toArray(".reveal").forEach((el: any) => {
      gsap.from(el, {
        opacity: 0,
        y: 50,
        duration: 1,
        scrollTrigger: {
          trigger: el,
          start: "top 85%"
        }
      });
    });
  }

  // Handle first load and navigation
  document.addEventListener("astro:page-load", initHome);
</script>
