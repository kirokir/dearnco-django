---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";

let dynamicProducts: any[] = [];
let industryModels: any[] = [];
let modelsSectionConfig = {
  title: "Framework Library",
  description: "Standardized architectural models and business frameworks designed to solve specific operational challenges across Indian industry verticals.",
  collage_url: "/indian_business_models_collage_1776926783752.png"
};

if (supabase) {
  try {
    const [productsRes, modelsRes, modelsConfigRes] = await Promise.all([
      supabase.from("products").select("*").eq("status", "active").order("sort_order", { ascending: true }),
      supabase.from("industry_models").select("*").order("sort_order", { ascending: true }),
      supabase.from("site_config").select("data").eq("key", "models_section").single()
    ]);
    
    if (productsRes.error) console.error("Products Fetch Error:", productsRes.error);
    else dynamicProducts = productsRes.data || [];
 
    if (modelsRes.error) console.error("Models Fetch Error:", modelsRes.error);
    else industryModels = modelsRes.data || [];

    if (modelsConfigRes.data) {
      modelsSectionConfig = modelsConfigRes.data.data;
    }
  } catch (e) {
    console.error("Products SSR Crash Caught:", e);
  }
}

import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AutoCarousel from "../../components/AutoCarousel";
---

<Layout title="Products — Kinbo" description="Explore KINBO TECHNOLOGIES PRIVATE LIMITED's product ecosystem: intelligent applications for healthcare, consumer technology, and enterprise systems.">
  
  <!-- BreadcrumbList JSON-LD -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://portfolio-sage-two-43.vercel.app" },
        { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://portfolio-sage-two-43.vercel.app/products" }
      ]
    },
    ...dynamicProducts.map(p => ({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": p.name,
      "description": p.description,
      "brand": { "@type": "Organization", "name": "KINBO TECHNOLOGIES PRIVATE LIMITED" },
      "category": p.category || "Technology",
      "url": `https://portfolio-sage-two-43.vercel.app/products`
    }))
  ])} />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&display=swap" rel="stylesheet" slot="head" />
  <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet" slot="head" />

  <div class="ks-page">
    <!-- HERO -->
    <div class="sub-hero">
      <div class="sub-crumb hero-anim">
        HOME <span class="sep">/</span> <span style="color: var(--ks-teal);">PRODUCTS</span>
      </div>
      <h1 class="sub-h hero-anim">A connected<br><span class="accent-teal">ecosystem.</span></h1>
      <p class="sub-tagline hero-anim">KINBO currently focuses on integrated applications that form a connected system. Insights generated in one application guide actions in another — from understanding to action, transparently.</p>
      <div class="hero-anim" style="margin-top: 24px;">
        <a href="/showcase" class="sub-cta-btn sub-cta-btn--teal">Go to Showcase &rarr;</a>
      </div>
    </div>

    <!-- GLOWUP -->
    <div class="product-block hero-anim" id="glowup">
      <div class="product-header">
        <div class="w-12 h-12 rounded-xl bg-teal/10 border border-teal/20 flex items-center justify-center text-teal">
          <i class="ti ti-face-id" style="font-size: 24px;"></i>
        </div>
        <div>
          <h2 class="product-title">Glowup</h2>
          <span class="product-subtitle">Skin Health Intelligence</span>
        </div>
      </div>
      
      <p class="product-desc">Glowup is a consumer application that helps users understand and track visible skin health indicators using image analysis and structured reporting. It provides practical, non-medical insights to support personal skin care decisions.</p>

      <div class="features-grid">
        <div class="feat-card">
          <h4 class="feat-title">Skin Assessment</h4>
          <p class="feat-desc">Users capture facial images and the system analyzes visible patterns to identify possible skin condition indicators.</p>
        </div>
        <div class="feat-card">
          <h4 class="feat-title">Condition Scoring</h4>
          <p class="feat-desc">The application generates structured reports showing relative severity levels of different skin conditions.</p>
        </div>
        <div class="feat-card">
          <h4 class="feat-title">Insight Dashboard</h4>
          <p class="feat-desc">Users receive explanations of what each condition indicator represents and how lifestyle habits may influence them.</p>
        </div>
        <div class="feat-card">
          <h4 class="feat-title">Progress Tracking</h4>
          <p class="feat-desc">Users repeat scans over time and view changes through a progress dashboard showing trends and comparisons.</p>
        </div>
      </div>

      <div class="carousel-container">
        <span class="carousel-label">Product Interface</span>
        <AutoCarousel client:load items={[
            "https://images.unsplash.com/photo-1512941937669-90a1358b335c?auto=format&fit=crop&w=400&h=800",
            "https://images.unsplash.com/photo-1523206489230-c012c6422b1f?auto=format&fit=crop&w=400&h=800",
            "https://images.unsplash.com/photo-1551650975-87deedd944c3?auto=format&fit=crop&w=400&h=800"
        ]} />
      </div>

      <div class="disclaimer-banner">
        <p>⚠ Disclaimer: Glowup does not provide medical diagnosis and is intended only for informational and personal tracking purposes. Always consult a qualified healthcare professional for medical advice.</p>
      </div>
    </div>

    <!-- RELIC -->
    <div class="product-block hero-anim" id="relic">
      <div class="product-header">
        <div class="w-12 h-12 rounded-xl bg-purple/10 border border-purple/20 flex items-center justify-center text-purple">
          <i class="ti ti-shopping-bag" style="font-size: 24px;"></i>
        </div>
        <div>
          <h2 class="product-title">Relic</h2>
          <span class="product-subtitle text-purple">Creator Marketplace</span>
        </div>
      </div>

      <p class="product-desc">Relic is a digital multivendor marketplace that allows creators, students, and independent sellers to open online stores easily. It removes the technical barriers to e-commerce so sellers can focus on what they do best.</p>

      <div class="features-grid">
        <div class="feat-card">
          <h4 class="feat-title">Seller Onboarding</h4>
          <p class="feat-desc">Sellers can register and begin offering products with minimal setup. No technical knowledge required.</p>
        </div>
        <div class="feat-card">
          <h4 class="feat-title">Personalized Stores</h4>
          <p class="feat-desc">Each seller can maintain their own store page and organize their products for customers.</p>
        </div>
        <div class="feat-card">
          <h4 class="feat-title">Customer Experience</h4>
          <p class="feat-desc">Buyers can follow stores they trust and discover products through recommendations and community signals.</p>
        </div>
        <div class="feat-card">
          <h4 class="feat-title">Cross-Platform Sync</h4>
          <p class="feat-desc">Purchases and account data can be synchronized across devices for consistent user experience.</p>
        </div>
      </div>

      <div class="carousel-container">
        <span class="carousel-label">Relic Experience</span>
        <AutoCarousel client:load items={[
            "https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?auto=format&fit=crop&w=400&h=800",
            "https://images.unsplash.com/photo-1472851294608-062f824d29cc?auto=format&fit=crop&w=400&h=800",
            "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=400&h=800"
        ]} />
      </div>
    </div>

    <!-- CONNECTION / INTEGRATION -->
    <div class="info-section hero-anim">
      <div class="info-ghost-num">⇄</div>
      <h3 class="info-title">How They Connect</h3>
      <div class="info-content">
        <p>Glowup identifies user skin concerns and suggests categories of products that may help address them. Relic provides a marketplace where users can discover relevant products offered by independent sellers.</p>
        <p>This connection allows users to move from insight to action in a transparent way. Users remain in full control of their decisions and product selection — the system informs, it does not prescribe.</p>
      </div>
    </div>

    <!-- DYNAMIC PRODUCTS -->
    {dynamicProducts.length > 0 && (
      <div class="info-section hero-anim">
        <h3 class="info-title mb-6">More Ecosystem Products</h3>
        <div class="dynamic-grid">
          {dynamicProducts.map((prod) => (
            <div class="dynamic-card">
              <div class="flex items-center gap-4 mb-4">
                {prod.logo_url ? (
                    <img src={prod.logo_url} alt={prod.name} class="w-10 h-10 rounded-lg object-contain bg-charcoal-dark/50 p-2" />
                ) : (
                    <div class="w-10 h-10 rounded-lg bg-teal/10 border border-teal/20 flex items-center justify-center">
                        <span class="text-teal font-bold">{prod.name.charAt(0)}</span>
                    </div>
                )}
                <div>
                   <h4 class="font-inter text-md font-bold text-offwhite mb-0.5">{prod.name}</h4>
                   {prod.tagline && <span class="font-mono text-[9px] text-teal uppercase tracking-widest">{prod.tagline}</span>}
                </div>
              </div>
              <p class="text-xs text-muted leading-relaxed mb-4">{prod.description}</p>
              {prod.screenshots && prod.screenshots.length > 0 && (
                <div class="pt-2 pointer-events-none grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all">
                    <AutoCarousel client:load items={prod.screenshots} speed={30} />
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- MODELS SECTION -->
    <div class="info-section hero-anim" id="models">
      <h3 class="info-title">{modelsSectionConfig.title}</h3>
      <p class="product-desc max-w-2xl">{modelsSectionConfig.description}</p>

      {industryModels.length > 0 ? (
        <div class="models-container mt-8">
          <div class="collage-block mb-10">
              <img 
                src={modelsSectionConfig.collage_url} 
                alt="Business Ecosystem" 
                class="collage-img"
              />
              <div class="collage-overlay">
                  <span class="font-mono text-[9px] text-teal uppercase tracking-widest block mb-1">Integrated Verticals</span>
                  <h4 class="font-inter text-lg font-bold text-offwhite">Scaling the Indian Enterprise</h4>
              </div>
          </div>

          <div class="models-grid">
            {industryModels.map((m) => (
              <div class={`model-card ${m.is_featured ? 'model-card--featured' : ''}`}>
                <div class="flex items-start gap-4">
                  <div class="model-icon">
                    {m.icon_type === 'wp' && <i class="ti ti-news"></i>}
                    {m.icon_type === 'jewel' && <i class="ti ti-diamond"></i>}
                    {m.icon_type === 'fashion' && <i class="ti ti-hanger"></i>}
                    {m.icon_type === 'bank' && <i class="ti ti-building-bank"></i>}
                    {m.icon_type === 'boutique' && <i class="ti ti-messages"></i>}
                    {m.icon_type === 'market' && <i class="ti ti-shopping-cart"></i>}
                    {m.icon_type === 'eng' && <i class="ti ti-settings"></i>}
                    {m.icon_type === 'health' && <i class="ti ti-heart-rate-monitor"></i>}
                    {!['wp','jewel','fashion','bank','boutique','market','eng','health'].includes(m.icon_type) && <i class="ti ti-file-text"></i>}
                  </div>
                  <div class="flex-1">
                    <h4 class="model-title">{m.title}</h4>
                    <p class="model-desc">{m.description}</p>
                    <div class="model-meta">
                      {m.benchmark_name && (
                        <span class="model-benchmark">
                          Example: {m.benchmark_url ? <a href={m.benchmark_url} target="_blank" class="text-teal hover:underline">{m.benchmark_name}</a> : m.benchmark_name}
                        </span>
                      )}
                      <span class="model-cat">
                        {m.category}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="text-center p-12 border border-dashed border-[var(--ks-border)] rounded-2xl">
          <p class="font-lora text-xs text-muted italic">Framework models are being updated. Check back soon for the latest industry benchmarks.</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .ks-page {
    --ks-bg: #0a0a0c;
    --ks-surface: #0f1117;
    --ks-border: rgba(255, 255, 255, 0.07);
    --ks-text-primary: #f0f0ec;
    --ks-text-muted: rgba(240, 240, 236, 0.40);
    --ks-text-faint: rgba(240, 240, 236, 0.6);
    --ks-label: rgba(240, 240, 236, 0.7);
    --ks-teal: #2dd4bf;
    --ks-purple: #a78bfa;

    background: var(--ks-bg);
    min-height: 100vh;
    max-width: 1200px;
    margin: 0 auto;
    margin-top: 72px;
    font-family: 'Inter', sans-serif;
  }

  /* SUB HERO */
  .sub-hero {
    padding: 48px 28px 44px;
    border-bottom: 0.5px solid var(--ks-border);
  }
  .sub-crumb {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ks-text-faint);
    margin-bottom: 24px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .sub-crumb .sep { color: rgba(240,240,236,0.12); }
  .sub-h {
    font-family: 'Syne', sans-serif;
    font-size: clamp(36px, 5.5vw, 58px);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -1.5px;
    color: var(--ks-text-primary);
    margin: 0;
  }
  .sub-h .accent-teal { color: var(--ks-teal); }
  .sub-tagline {
    font-size: 14px;
    color: var(--ks-text-muted);
    margin-top: 16px;
    max-width: 600px;
    line-height: 1.6;
  }
  .sub-cta-btn {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: 4px;
    text-decoration: none;
    border: 0.5px solid;
    background: none;
    transition: opacity 0.18s;
    white-space: nowrap;
    display: inline-block;
  }
  .sub-cta-btn:hover { opacity: 0.65; }
  .sub-cta-btn--teal { color: var(--ks-teal); border-color: rgba(45, 212, 191, 0.22); }

  /* PRODUCT BLOCK */
  .product-block {
    padding: 44px 28px;
    border-bottom: 0.5px solid var(--ks-border);
  }
  .product-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .product-title {
    font-family: 'Syne', sans-serif;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--ks-text-primary);
    margin: 0 0 2px 0;
  }
  .product-subtitle {
    font-family: monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ks-teal);
  }
  .product-desc {
    font-size: 13px;
    color: var(--ks-text-muted);
    line-height: 1.7;
    max-width: 720px;
    margin-bottom: 28px;
  }

  /* FEATURES GRID */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }
  @media (max-width: 640px) {
    .features-grid { grid-template-columns: 1fr; }
  }
  .feat-card {
    padding: 20px;
    border: 0.5px solid var(--ks-border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.01);
  }
  .feat-title {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: var(--ks-text-primary);
    margin-bottom: 6px;
  }
  .feat-desc {
    font-size: 12px;
    color: var(--ks-text-muted);
    line-height: 1.6;
  }

  /* CAROUSEL */
  .carousel-container {
    margin-bottom: 32px;
  }
  .carousel-label {
    font-family: monospace;
    font-size: 9px;
    color: var(--ks-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: block;
    margin-bottom: 12px;
  }

  /* DISCLAIMER */
  .disclaimer-banner {
    padding: 12px 16px;
    border: 0.5px solid rgba(234, 179, 8, 0.2);
    background: rgba(234, 179, 8, 0.03);
    border-radius: 8px;
  }
  .disclaimer-banner p {
    font-family: monospace;
    font-size: 10px;
    color: rgba(234, 179, 8, 0.8);
    line-height: 1.5;
    margin: 0;
  }

  /* INFO SECTION */
  .info-section {
    padding: 44px 28px;
    border-bottom: 0.5px solid var(--ks-border);
    position: relative;
    overflow: hidden;
  }
  .info-ghost-num {
    font-family: 'Syne', sans-serif;
    font-size: 80px;
    font-weight: 800;
    line-height: 1;
    position: absolute;
    top: 10px;
    right: 20px;
    color: var(--ks-teal);
    opacity: 0.03;
    pointer-events: none;
    user-select: none;
  }
  .info-title {
    font-family: 'Syne', sans-serif;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--ks-text-primary);
    margin-bottom: 16px;
  }
  .info-content {
    font-size: 13px;
    color: var(--ks-text-muted);
    line-height: 1.7;
    max-width: 680px;
  }
  .info-content p {
    margin-bottom: 12px;
  }

  /* DYNAMIC PRODUCTS GRID */
  .dynamic-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 24px;
  }
  @media (max-width: 640px) {
    .dynamic-grid { grid-template-columns: 1fr; }
  }
  .dynamic-card {
    padding: 24px;
    border: 0.5px solid var(--ks-border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.015);
  }

  /* MODELS */
  .collage-block {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 0.5px solid var(--ks-border);
    height: 240px;
  }
  .collage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
  }
  .collage-overlay {
    position: absolute;
    bottom: 20px;
    left: 20px;
    z-index: 10;
  }
  .models-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 1024px) {
    .models-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .models-grid { grid-template-columns: 1fr; }
  }
  .model-card {
    padding: 20px;
    border: 0.5px solid var(--ks-border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.01);
    transition: border-color 0.2s, background 0.2s;
  }
  .model-card:hover {
    border-color: rgba(45, 212, 191, 0.25);
    background: rgba(45, 212, 191, 0.01);
  }
  .model-card--featured {
    grid-column: 1 / -1;
  }
  .model-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(45, 212, 191, 0.08);
    border: 0.5px solid rgba(45, 212, 191, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ks-teal);
    font-size: 18px;
    flex-shrink: 0;
  }
  .model-title {
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    font-weight: 800;
    color: var(--ks-text-primary);
    margin: 0 0 6px 0;
  }
  .model-desc {
    font-size: 12px;
    color: var(--ks-text-muted);
    line-height: 1.6;
    margin-bottom: 12px;
  }
  .model-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 9px;
    font-family: monospace;
  }
  .model-benchmark {
    color: var(--ks-text-muted);
  }
  .model-cat {
    color: var(--ks-teal);
    border: 0.5px solid rgba(45, 212, 191, 0.2);
    padding: 1px 6px;
    border-radius: 3px;
  }

  @media (max-width: 640px) {
    .sub-hero { padding: 40px 16px 32px; }
    .product-block { padding: 32px 16px; }
    .info-section { padding: 32px 16px; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initProducts() {
    gsap.fromTo(".hero-anim", 
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: "power2.out", delay: 0.15 }
    );
  }
  document.addEventListener("astro:page-load", initProducts);
</script>
