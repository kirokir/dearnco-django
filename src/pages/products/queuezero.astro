---
import Layout from "../../layouts/Layout.astro";
export const prerender = false;

const pageTitle = "QueueZero™ (Q0) | Healthcare Infrastructure";
const pageDescription = "QueueZero™ transforms waiting-room time into structured pre-consultation clinical intelligence — enabling physicians to focus entirely on clinical judgment.";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="q0-container">
    
    <!-- Hero Section -->
    <section class="hero" id="hero">
      <div class="hero-bg">
        <img src="/products/q0/hero_bg.png" alt="" class="hero-bg-img" />
        <div class="hero-overlay"></div>
      </div>
      
      <div class="container relative z-10">
        <div class="hero-grid">
          <div class="hero-content">
            <div class="badge hero-anim">Powered by PhysioMimica™</div>
            <h1 class="hero-title hero-anim">
              Recover 10–15 Minutes <br />
              <span class="text-accent">From Every Consultation.</span>
            </h1>
            <p class="hero-subheadline hero-anim">
              QueueZero™ transforms waiting-room time into structured pre-consultation clinical intelligence — enabling physicians to focus entirely on clinical judgment.
            </p>
            <div class="hero-actions hero-anim">
              <a href="#contact" class="btn btn-primary">Request Pilot</a>
              <a href="#clinical" class="btn btn-secondary">Clinical Partnerships</a>
            </div>
            
            <div class="trust-strip hero-anim">
              <div class="trust-item">Working Prototype</div>
              <div class="trust-divider"></div>
              <div class="trust-item">Hospital Testing Access</div>
              <div class="trust-divider"></div>
              <div class="trust-item">DOI-Published Research</div>
              <div class="trust-divider"></div>
              <div class="trust-item">Best Paper Award</div>
            </div>
          </div>
          
          <div class="hero-visual hero-anim">
            <div class="product-render-container">
              <img src="/products/q0/product_render.png" alt="QueueZero Dashboard Render" class="product-render" />
              <div class="render-glow"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: The Problem -->
    <section class="problem" id="problem">
      <div class="container">
        <div class="section-header reveal">
          <h2 class="section-title">The Operational Bottleneck Hidden Inside Every Outpatient Department</h2>
          <p class="section-desc">Healthcare efficiency is limited not by clinical skill, but by administrative and intake friction.</p>
        </div>
        
        <div class="problem-grid">
          <div class="problem-card reveal">
            <div class="icon">×</div>
            <h3>Repetitive Intake Workflows</h3>
            <p>Manual data collection consumes 40% of consultation windows.</p>
          </div>
          <div class="problem-card reveal">
            <div class="icon">×</div>
            <h3>Consultation Inefficiency</h3>
            <p>Doctors spend critical minutes on basic history gathering.</p>
          </div>
          <div class="problem-card reveal">
            <div class="icon">×</div>
            <h3>Physician Cognitive Overload</h3>
            <p>Filtering unstructured patient data increases burnout risk.</p>
          </div>
          <div class="problem-card reveal">
            <div class="icon">×</div>
            <h3>Unstructured Pre-analysis</h3>
            <p>Lack of standardized data before the doctor-patient encounter.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: What Q0 Does -->
    <section class="solution" id="solution">
      <div class="container">
        <div class="section-header reveal">
          <h2 class="section-title">Deterministic Pre-Consultation Intelligence Infrastructure</h2>
          <p class="section-desc">A seamless bridge between the waiting room and the consultation room.</p>
        </div>
        
        <div class="workflow-visual reveal">
          <div class="workflow-step">
            <div class="step-num">01</div>
            <h4>Patient Intake</h4>
            <p>Structured data capture at the point of arrival.</p>
          </div>
          <div class="workflow-arrow"></div>
          <div class="workflow-step">
            <div class="step-num">02</div>
            <h4>Physiological Assessment</h4>
            <p>Proprietary edge-deployed assessment pipeline.</p>
          </div>
          <div class="workflow-arrow"></div>
          <div class="workflow-step">
            <div class="step-num">03</div>
            <h4>Structured Analysis</h4>
            <p>Deterministic clinical workflow coordination.</p>
          </div>
          <div class="workflow-arrow"></div>
          <div class="workflow-step">
            <div class="step-num">04</div>
            <h4>Doctor Review</h4>
            <p>Intelligence delivered before consultation begins.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: PhysioMimica™ -->
    <section class="physiomimica" id="physiomimica">
      <div class="container">
        <div class="physio-grid">
          <div class="physio-visual reveal">
            <div class="visual-container">
              <img src="/products/q0/physiomimica_viz.png" alt="PhysioMimica Visualization" class="physio-img" />
              <div class="scan-line"></div>
            </div>
          </div>
          <div class="physio-content reveal">
            <div class="badge">Proprietary clinical intelligence</div>
            <h2 class="section-title">PhysioMimica™: The Intelligence Layer</h2>
            <p class="physio-desc">
              Built on a proprietary deterministic clinical workflow engine, PhysioMimica™ orchestrates complex data streams into actionable physician intelligence.
            </p>
            <ul class="physio-features">
              <li>
                <strong>Deterministic Orchestration</strong>
                <p>Rule-constrained analysis pipelines that eliminate probabilistic hallucinations.</p>
              </li>
              <li>
                <strong>Explainable Assistance</strong>
                <p>Every finding is trace-linked to raw physiological data for total auditability.</p>
              </li>
              <li>
                <strong>Physician-Controlled Outputs</strong>
                <p>A collaborative system where the physician remains the final authority.</p>
              </li>
              <li>
                <strong>Edge-First Deployment</strong>
                <p>Secure, low-latency processing directly within clinical environments.</p>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Report Experience -->
    <section class="report" id="report">
      <div class="container">
        <div class="section-header reveal">
          <h2 class="section-title">Structured Intelligence, Delivered Before Consultation</h2>
          <p class="section-desc">A premium reporting experience designed for rapid clinical absorption.</p>
        </div>
        
        <div class="report-showcase reveal">
          <div class="phone-mockup">
            <img src="/products/q0/report_mockup.png" alt="QueueZero Report Experience" class="report-img" />
          </div>
          <div class="report-features">
            <div class="report-feat-item">
              <div class="feat-icon">●</div>
              <div>
                <h4>Localized Clinical Findings</h4>
                <p>Specific physiological observations mapped to diagnostic confidence levels.</p>
              </div>
            </div>
            <div class="report-feat-item">
              <div class="feat-icon">●</div>
              <div>
                <h4>Confidence-Weighted Indicators</h4>
                <p>Clear visualization of data reliability across all captured metrics.</p>
              </div>
            </div>
            <div class="report-feat-item">
              <div class="feat-icon">●</div>
              <div>
                <h4>Physiological Summaries</h4>
                <p>Automated, high-fidelity summaries of patient physiological state.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 6: Operational Impact -->
    <section class="impact" id="impact">
      <div class="container">
        <div class="impact-grid">
          <div class="impact-card reveal">
            <div class="impact-value">10–15</div>
            <div class="impact-label">Minutes Recovered / Consultation</div>
          </div>
          <div class="impact-card reveal">
            <div class="impact-value">40%</div>
            <div class="impact-label">Increase in Patient Throughput</div>
          </div>
          <div class="impact-card reveal">
            <div class="impact-value">Zero</div>
            <div class="impact-label">Manual Data Entry Required</div>
          </div>
          <div class="impact-card reveal">
            <div class="impact-value">100%</div>
            <div class="impact-label">Standardized Pre-Consultation Data</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 7: Deployment Model -->
    <section class="deployment" id="deployment">
      <div class="container">
        <div class="deploy-grid">
          <div class="deploy-content reveal">
            <h2 class="section-title">Designed for Real Clinical Environments</h2>
            <p class="section-desc">Infrastructure that works in high-pressure medical settings, not just in theory.</p>
            
            <div class="deploy-items">
              <div class="deploy-item">
                <h4>Edge-First Execution</h4>
                <p>Local processing ensures 100% uptime and data sovereignty without cloud dependency.</p>
              </div>
              <div class="deploy-item">
                <h4>Hardware + SaaS Ecosystem</h4>
                <p>Seamlessly integrated proprietary sensors and management software.</p>
              </div>
              <div class="deploy-item">
                <h4>Offline-Capable</h4>
                <p>Operational even in environments with intermittent network connectivity.</p>
              </div>
              <div class="deploy-item">
                <h4>Scalable Infrastructure</h4>
                <p>From single-doctor clinics to multi-specialty hospital networks.</p>
              </div>
            </div>
          </div>
          <div class="deploy-visual reveal">
            <div class="deploy-map">
              <div class="node node-center"></div>
              <div class="node node-1"></div>
              <div class="node node-2"></div>
              <div class="node node-3"></div>
              <div class="pulse-ring"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 8 & 9: Market & Traction -->
    <section class="traction" id="traction">
      <div class="container">
        <div class="section-header reveal">
          <h2 class="section-title">Institutional Traction & Deployment</h2>
          <p class="section-desc">Building the foundation for deterministic healthcare infrastructure.</p>
        </div>
        
        <div class="traction-grid">
          <div class="traction-card reveal">
            <div class="traction-tag">Operational</div>
            <h4>Working Prototype</h4>
            <p>End-to-end clinical workflow validation completed.</p>
          </div>
          <div class="traction-card reveal">
            <div class="traction-tag">Validation</div>
            <h4>Hospital Testing Access</h4>
            <p>Direct deployment pathways in leading medical institutions.</p>
          </div>
          <div class="traction-card reveal">
            <div class="traction-tag">Academic</div>
            <h4>DOI-Published Research</h4>
            <p>Rigorous peer-reviewed clinical methodology.</p>
          </div>
          <div class="traction-card reveal">
            <div class="traction-tag">Awarded</div>
            <h4>Best Paper Award</h4>
            <p>Recognized for innovation in healthcare orchestration.</p>
          </div>
          <div class="traction-card reveal">
            <div class="traction-tag">Incubation</div>
            <h4>IITM HTIC Incubation Engagement</h4>
            <p>Strategic alignment with elite medical tech accelerators.</p>
          </div>
          <div class="traction-card reveal">
            <div class="traction-tag">Interest</div>
            <h4>Strategic Partnerships</h4>
            <p>Active engagement from institutional and angel partners.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 10: Team -->
    <section class="team" id="team">
      <div class="container">
        <div class="section-header reveal">
          <h2 class="section-title">Core Systems Engineering</h2>
          <p class="section-desc">A multidisciplinary team bridging engineering and clinical excellence.</p>
        </div>
        
        <div class="team-grid">
          <div class="team-card reveal">
            <div class="team-info">
              <h3>Arjun Jayesh</h3>
              <p class="role">Founder & Systems Architect</p>
              <p class="expertise">Deterministic Systems | Multi-Agent Architecture | Embedded Engineering</p>
            </div>
          </div>
          <div class="advisor-group reveal">
            <h4>Clinical & Strategic Advisors</h4>
            <div class="advisors">
              <div class="advisor">Dr. Arun Raaza</div>
              <div class="advisor">Dr. Senthil Purushothaman</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 11: CTA -->
    <section class="cta" id="contact">
      <div class="container">
        <div class="cta-card reveal">
          <div class="cta-content">
            <h2 class="cta-title">Building Operational Infrastructure for the Future of Healthcare.</h2>
            <div class="cta-actions">
              <a href="mailto:contact@dear.is-a.dev" class="btn btn-primary">Request Pilot</a>
              <a href="#" class="btn btn-secondary">Institutional Partnerships</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  :root {
    --bg-dark: #050a18;
    --bg-black: #0a0a0a;
    --accent: #00f2ff;
    --accent-glow: rgba(0, 242, 255, 0.3);
    --text-white: #f8f9fa;
    --text-muted: #a0aec0;
    --glass: rgba(255, 255, 255, 0.03);
    --glass-border: rgba(255, 255, 255, 0.08);
  }

  .q0-container {
    background-color: var(--bg-dark);
    color: var(--text-white);
    font-family: 'Inter', system-ui, sans-serif;
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Typography */
  .text-accent { color: var(--accent); }
  
  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    color: var(--accent);
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 10rem 0 6rem;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, transparent, var(--bg-dark));
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    line-height: 1;
    margin-bottom: 2rem;
    letter-spacing: -0.03em;
  }

  .hero-subheadline {
    font-size: 1.25rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 3rem;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .btn {
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--bg-dark);
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px var(--accent-glow);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-white);
    border: 1px solid var(--glass-border);
  }

  .btn-secondary:hover {
    background: var(--glass);
    border-color: var(--accent);
  }

  .trust-strip {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    opacity: 0.6;
    flex-wrap: wrap;
  }

  .trust-item {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .trust-divider {
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 50%;
  }

  .product-render-container {
    position: relative;
  }

  .product-render {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    border: 1px solid var(--glass-border);
  }

  .render-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, var(--accent-glow), transparent 70%);
    z-index: -1;
    filter: blur(40px);
  }

  /* Problem Section */
  .problem {
    padding: 8rem 0;
    background: var(--bg-black);
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .problem-card {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    padding: 2.5rem;
    border-radius: 20px;
    transition: all 0.3s ease;
  }

  .problem-card:hover {
    border-color: rgba(255, 0, 0, 0.3);
    transform: translateY(-5px);
  }

  .problem-card .icon {
    font-size: 2rem;
    color: #ff4d4d;
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .problem-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .problem-card p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Solution Section */
  .solution {
    padding: 8rem 0;
  }

  .workflow-visual {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    position: relative;
    padding-top: 2rem;
  }

  .workflow-step {
    flex: 1;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .step-num {
    font-size: 3rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.05);
    position: absolute;
    top: -2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: -1;
  }

  .workflow-step h4 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--accent);
  }

  .workflow-step p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .workflow-arrow {
    flex: 0 0 40px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    margin-top: 1.5rem;
    opacity: 0.3;
  }

  /* PhysioMimica Section */
  .physiomimica {
    padding: 10rem 0;
    background: linear-gradient(180deg, var(--bg-dark), var(--bg-black));
  }
  .physio-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .physio-img {
    width: 100%;
    border-radius: 24px;
    border: 1px solid var(--glass-border);
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
  }
  .visual-container {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
  }
  .scan-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 15px var(--accent);
    animation: scan 4s linear infinite;
    opacity: 0.5;
  }
  @keyframes scan {
    0% { top: 0; }
    100% { top: 100%; }
  }
  .physio-features {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }
  .physio-features li strong {
    display: block;
    color: var(--accent);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .physio-features li p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Report Section */
  .report {
    padding: 8rem 0;
    background: var(--bg-black);
  }
  .report-showcase {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 5rem;
    align-items: center;
  }
  .phone-mockup {
    position: relative;
    padding: 1rem;
    background: #111;
    border-radius: 40px;
    border: 4px solid #222;
    box-shadow: 0 50px 100px rgba(0,0,0,0.8);
  }
  .report-img {
    width: 100%;
    border-radius: 30px;
    display: block;
  }
  .report-features {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .report-feat-item {
    display: flex;
    gap: 1.5rem;
  }
  .feat-icon {
    color: var(--accent);
    font-size: 0.8rem;
    margin-top: 0.3rem;
  }
  .report-feat-item h4 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .report-feat-item p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  /* Impact Section */
  .impact {
    padding: 6rem 0;
    background: var(--bg-dark);
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .impact-card {
    text-align: center;
  }
  .impact-value {
    font-size: 3.5rem;
    font-weight: 900;
    color: var(--accent);
    margin-bottom: 0.5rem;
    letter-spacing: -0.05em;
  }
  .impact-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  /* Deployment Section */
  .deployment {
    padding: 10rem 0;
  }
  .deploy-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .deploy-items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 4rem;
  }
  .deploy-item h4 {
    color: var(--accent);
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }
  .deploy-item p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .deploy-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .deploy-map {
    position: relative;
    width: 300px;
    height: 300px;
  }
