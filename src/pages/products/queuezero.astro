<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initQ0() {
    // Hero Animations
    gsap.from(".hero-anim", {
      opacity: 0,
      y: 30,
      duration: 1,
      stagger: 0.2,
      ease: "power3.out"
    });

    // Reveal Animations
    gsap.utils.toArray(".reveal").forEach((el: any) => {
      gsap.from(el, {
        opacity: 0,
        y: 50,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
        }
      });
    });

    // Parallax Hero Background
    gsap.to(".hero-bg-img", {
      yPercent: 30,
      ease: "none",
      scrollTrigger: {
        trigger: "#hero",
        start: "top top",
        end: "bottom top",
        scrub: true
      }
    });

    // Impact Numbers Animation
    gsap.utils.toArray(".impact-value").forEach((el: any) => {
      const val = el.innerText;
      const isPercent = val.includes('%');
      const target = parseFloat(val);
      
      gsap.from(el, {
        innerText: 0,
        duration: 2,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el,
          start: "top 90%",
        },
        onUpdate: function() {
          const current = Math.floor(this.targets()[0].innerText);
          el.innerText = isPercent ? current + '%' : current;
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initQ0);
</script>
