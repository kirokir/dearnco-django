---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { supabaseAdmin } from "../../lib/supabase";

let servicesAssets: any = {};
if (supabaseAdmin) {
  const { data } = await supabaseAdmin.from('site_config').select('data').eq('key', 'services_assets').single();
  if (data) servicesAssets = data.data;
}
---

<Layout title="Kinbo Cares — Product Support" description="Direct support for all Kinbo products. No tickets, no auto-replies. Queries answered by the team that built the system.">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&display=swap" rel="stylesheet" slot="head" />
  <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet" slot="head" />

  <div class="ks-page">
    <!-- HERO -->
    <div class="sub-hero">
      <div class="sub-crumb hero-anim">
        HOME <span class="sep">/</span> SERVICES <span class="sep">/</span> <span style="color: var(--ks-teal);">KINBO CARES</span>
      </div>
      <h1 class="sub-h hero-anim">Questions get<br><span class="accent-teal">real answers.</span></h1>
      <p class="sub-tagline hero-anim">No ticket queues. No auto-replies. Direct support from the team that built the system.</p>
      
      {servicesAssets.cares_hero && (
        <div class="hero-image-slot hero-anim mt-12 rounded-xl overflow-hidden border border-[var(--ks-border)] aspect-video max-h-[500px]">
           <img src={servicesAssets.cares_hero} alt="Kinbo Cares" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      )}
    </div>

    <!-- SCOPE GRID -->
    <div class="scope-grid">
      <div class="scope-item">
        <div class="scope-num">01</div>
        <div class="scope-title">Product Questions</div>
        <div class="scope-desc">Ask what it does, what it doesn't, whether it fits your use case.</div>
      </div>
      <div class="scope-item">
        <div class="scope-num">02</div>
        <div class="scope-title">Troubleshooting</div>
        <div class="scope-desc">Describe what's broken. Get a diagnosis, not a FAQ link.</div>
      </div>
      <div class="scope-item">
        <div class="scope-num">03</div>
        <div class="scope-title">Onboarding</div>
        <div class="scope-desc">New to a Kinbo product? We walk you through it directly.</div>
      </div>
      <div class="scope-item">
        <div class="scope-num">04</div>
        <div class="scope-title">Feedback</div>
        <div class="scope-desc">What works, what doesn't, what's missing — this is where it goes.</div>
      </div>
      <div class="scope-item">
        <div class="scope-num">05</div>
        <div class="scope-title">Optimization</div>
        <div class="scope-desc">Already using it? We review your setup and recommend improvements.</div>
      </div>
      <div class="scope-item">
        <div class="scope-num">06</div>
        <div class="scope-title">Documentation</div>
        <div class="scope-desc">If it's undocumented and you need clarity, we fill the gap directly.</div>
      </div>
    </div>

    <!-- PRODUCTS ROW -->
    <div class="products-row">
      <span class="products-label">Products covered</span>
      <span class="prod-pill">QueueZero (Q0)</span>
      <span class="prod-pill">Glowup</span>
      <span class="prod-pill">Relic</span>
      <span class="prod-pill">Werher</span>
      <span class="prod-pill">Odiker</span>
      <span class="prod-pill">All Releases</span>
    </div>

    <!-- BOTTOM BAR -->
    <div class="sub-bottom">
      <p class="sub-bottom-statement">Have a question<br>about a Kinbo product?</p>
      <a href="/chat" class="sub-cta-btn sub-cta-btn--teal">Submit a Query →</a>
    </div>
  </div>
</Layout>

<style>
  .ks-page {
    --ks-bg: #0a0a0c;
    --ks-surface: #0f1117;
    --ks-border: rgba(255, 255, 255, 0.07);
    --ks-text-primary: #f0f0ec;
    --ks-text-muted: rgba(240, 240, 236, 0.40);
    --ks-text-faint: rgba(240, 240, 236, 0.6);
    --ks-label: rgba(240, 240, 236, 0.7);
    --ks-teal: #2dd4bf;
    --ks-teal-bg: rgba(45, 212, 191, 0.08);
    --ks-teal-border: rgba(45, 212, 191, 0.22);
    --ks-purple: #a78bfa;
    --ks-purple-bg: rgba(167, 139, 250, 0.08);
    --ks-purple-border: rgba(167, 139, 250, 0.22);
    --ks-amber: #fbbf24;
    --ks-amber-bg: rgba(251, 191, 36, 0.08);
    --ks-amber-border: rgba(251, 191, 36, 0.22);

    background: var(--ks-bg);
    min-height: 100vh;
    max-width: 1200px;
    margin: 0 auto;
    margin-top: 72px;
    font-family: 'Inter', sans-serif;
  }

  /* SUB HERO */
  .sub-hero {
    padding: 48px 28px 36px;
    border-bottom: 0.5px solid var(--ks-border);
  }
  .sub-crumb {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ks-text-faint);
    margin-bottom: 24px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .sub-crumb .sep { color: rgba(240,240,236,0.12); }
  .sub-h {
    font-family: 'Syne', sans-serif;
    font-size: clamp(36px, 5.5vw, 58px);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -1.5px;
    color: var(--ks-text-primary);
    margin: 0;
  }
  .sub-h .accent-teal   { color: var(--ks-teal); }
  .sub-h .accent-purple { color: var(--ks-purple); }
  .sub-h .accent-amber  { color: var(--ks-amber); }
  .sub-tagline {
    font-size: 14px;
    color: var(--ks-text-muted);
    margin-top: 16px;
    max-width: 480px;
    line-height: 1.6;
  }

  /* SCOPE GRID */
  .scope-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 540px) {
    .scope-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .scope-item {
    padding: 24px 22px;
    border-right: 0.5px solid var(--ks-border);
    border-bottom: 0.5px solid var(--ks-border);
  }
  .scope-item:nth-child(3n) { border-right: none; }
  .scope-num {
    font-family: 'Syne', sans-serif;
    font-size: 38px;
    font-weight: 800;
    color: var(--ks-teal);
    opacity: 0.22;
    line-height: 1;
    margin-bottom: 10px;
    letter-spacing: -1px;
  }
  .scope-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--ks-text-primary);
    margin-bottom: 5px;
  }
  .scope-desc {
    font-size: 11px;
    color: var(--ks-text-muted);
    line-height: 1.55;
  }

  /* PRODUCTS ROW */
  .products-row {
    padding: 20px 28px;
    border-bottom: 0.5px solid var(--ks-border);
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
  }
  .products-label {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ks-text-faint);
    margin-right: 8px;
    flex-shrink: 0;
  }
  .prod-pill {
    font-size: 11px;
    color: var(--ks-teal);
    background: var(--ks-teal-bg);
    border: 0.5px solid var(--ks-teal-border);
    padding: 4px 12px;
    border-radius: 3px;
    white-space: nowrap;
  }

  /* BOTTOM BAR */
  .sub-bottom {
    padding: 32px 28px;
    border-bottom: 0.5px solid var(--ks-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .sub-bottom-statement {
    font-family: 'Syne', sans-serif;
    font-size: clamp(18px, 3vw, 22px);
    font-weight: 800;
    letter-spacing: -0.5px;
    color: rgba(240, 240, 236, 0.55);
    line-height: 1.1;
    margin: 0;
  }
  .sub-cta-btn {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: 4px;
    text-decoration: none;
    border: 0.5px solid;
    background: none;
    transition: opacity 0.18s;
    white-space: nowrap;
  }
  .sub-cta-btn:hover { opacity: 0.65; }
  .sub-cta-btn--teal   { color: var(--ks-teal);   border-color: var(--ks-teal-border); }
  .sub-cta-btn--purple { color: var(--ks-purple); border-color: var(--ks-purple-border); }
  .sub-cta-btn--amber  { color: var(--ks-amber);  border-color: var(--ks-amber-border); }

  @media (max-width: 640px) {
    .sub-hero { padding: 40px 16px 32px; }
    .scope-item { padding: 20px 16px; border-right: none !important; }
    .products-row { padding: 16px; }
    .sub-bottom { padding: 32px 16px; flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initCares() {
    gsap.fromTo(".hero-anim", 
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: "power2.out", delay: 0.15 }
    );
    gsap.from(".scope-item", {
      opacity: 0, y: 20, duration: 0.5, stagger: 0.12, ease: "power2.out",
      scrollTrigger: { trigger: ".scope-grid", start: "top 85%" }
    });
    gsap.from(".products-row, .sub-bottom", {
      opacity: 0, y: 20, duration: 0.5, stagger: 0.1, ease: "power2.out",
      scrollTrigger: { trigger: ".products-row", start: "top 95%" }
    });
  }
  document.addEventListener("astro:page-load", initCares);
</script>
