---
import Layout from "../layouts/Layout.astro";
import ShowcaseGallery from "../components/showcase/ShowcaseGallery";

export const prerender = false;

// Fetch showcase data server-side for SEO, or let client handle it.
// Let's pass it to the client for hydration.
import { createClient } from '@supabase/supabase-js';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.SUPABASE_SERVICE_ROLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

const { data: projects } = await supabase.from('showcase_projects').select('*').order('order_index', { ascending: true });
---

<Layout title="Showcase & Platforms — Kinbo Technologies" description="A premium gallery of websites, web applications, mobile apps, and AI systems built by Kinbo Technologies.">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&display=swap" rel="stylesheet" slot="head" />

  <div class="ks-page">
    <!-- HERO -->
    <div class="sub-hero">
      <div class="sub-crumb hero-anim">
        HOME <span class="sep">/</span> <span style="color: var(--ks-teal);">SHOWCASE</span>
      </div>
      <h1 class="sub-h hero-anim">Digital<br><span class="accent-teal">masterpieces.</span></h1>
      <p class="sub-tagline hero-anim">Explore our premium portfolio of enterprise dashboards, AI healthcare platforms, high-conversion websites, and seamless mobile applications.</p>
    </div>

    <div class="showcase-body">
      <ShowcaseGallery initialProjects={projects || []} client:load />
    </div>
  </div>

  <style>
    .ks-page {
      --ks-teal: #2A9D8F;
      --ks-bg: #0a0a0c;
      --ks-surface: #111113;
      --ks-border: rgba(240, 240, 236, 0.06);
      --ks-text-primary: #f0f0ec;
      --ks-text-muted: rgba(240, 240, 236, 0.55);
      --ks-text-faint: rgba(240, 240, 236, 0.30);
      background: var(--ks-bg);
      color: var(--ks-text-primary);
      min-height: 100vh;
      max-width: 1200px;
      margin: 0 auto;
      margin-top: 72px;
      font-family: 'Inter', sans-serif;
    }

    /* SUB HERO */
    .sub-hero {
      padding: 48px 28px 44px;
      border-bottom: 0.5px solid var(--ks-border);
    }
    .sub-crumb {
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ks-text-faint);
      margin-bottom: 24px;
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .sub-crumb .sep { color: rgba(240,240,236,0.12); }
    .sub-h {
      font-family: 'Syne', sans-serif;
      font-size: clamp(36px, 5.5vw, 58px);
      font-weight: 800;
      line-height: 0.94;
      letter-spacing: -1.5px;
      color: var(--ks-text-primary);
      margin: 0;
    }
    .sub-h .accent-teal { color: var(--ks-teal); }
    .sub-tagline {
      font-size: 14px;
      color: var(--ks-text-muted);
      margin-top: 16px;
      max-width: 600px;
      line-height: 1.6;
    }

    .showcase-body {
      padding: 48px 28px;
    }

    @media (max-width: 768px) {
      .sub-hero { padding: 40px 16px 32px; }
      .showcase-body { padding: 32px 16px; }
    }
  </style>
</Layout>
