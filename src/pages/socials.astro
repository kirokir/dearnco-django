---
export const prerender = false;
import Layout from "../layouts/Layout.astro";

const socials = [
  {
    name: "GitHub",
    handle: "@arjunjayesh",
    url: "https://github.com/arjunjayesh",
    description: "Open-source contributions, tools, and experimental repos.",
    gradient: "from-[#333] to-[#0d1117]",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" style="width: 24px; height: 24px;"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
  },
  {
    name: "Zenodo",
    handle: "Arjun Jayesh",
    url: "https://zenodo.org",
    description: "Research publications, datasets, and DOI-registered outputs.",
    gradient: "from-[#1a5276] to-[#0e2f44]",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" style="width: 24px; height: 24px;"><path d="M3 3h18v2H5.667L21 17v4H3v-2h14.333L3 7V3z"/></svg>`,
  },
  {
    name: "LinkedIn",
    handle: "Arjun Jayesh",
    url: "https://linkedin.com/in/arjunjayesh",
    description: "Professional network, thoughts on engineering leadership.",
    gradient: "from-[#0077b5] to-[#003d5c]",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" style="width: 24px; height: 24px;"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<Layout title="Socials — Kinbo" description="Connect with Kinbo Technologies.">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&display=swap" rel="stylesheet" slot="head" />
  
  <div class="ks-page">
    <!-- HERO -->
    <div class="sub-hero">
      <div class="sub-crumb hero-anim">
        HOME <span class="sep">/</span> <span style="color: var(--ks-amber);">SOCIALS</span>
      </div>
      <h1 class="sub-h hero-anim">Let's <span class="accent-amber">Connect.</span></h1>
      <p class="sub-tagline hero-anim">We believe in open research, collaborative engineering, and sharing knowledge freely. Reach out on our social channels.</p>
    </div>

    <!-- SOCIALS GRID -->
    <div class="service-grid hero-anim">
      {socials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer" class="svc-card group">
          <div class="flex items-center justify-between mb-4">
            <div class="w-10 h-10 rounded-lg bg-[var(--ks-amber-bg)] border border-[var(--ks-amber-border)] flex items-center justify-center text-[var(--ks-amber)]">
              <Fragment set:html={social.icon} />
            </div>
            <i class="ti ti-external-link text-[var(--ks-text-muted)] group-hover:text-[var(--ks-amber)] transition-colors duration-200" style="font-size: 18px;"></i>
          </div>
          <h3 class="svc-title group-hover:text-[var(--ks-amber)] transition-colors duration-200">{social.name}</h3>
          <p class="svc-one mb-2">{social.handle}</p>
          <p class="text-[12px] text-[var(--ks-text-muted)] leading-relaxed mt-2">{social.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .ks-page {
    --ks-bg: #0a0a0c;
    --ks-surface: #0f1117;
    --ks-border: rgba(255, 255, 255, 0.07);
    --ks-text-primary: #f0f0ec;
    --ks-text-muted: rgba(240, 240, 236, 0.40);
    --ks-text-faint: rgba(240, 240, 236, 0.6);
    --ks-label: rgba(240, 240, 236, 0.7);
    --ks-amber: #fbbf24;
    --ks-amber-bg: rgba(251, 191, 36, 0.08);
    --ks-amber-border: rgba(251, 191, 36, 0.22);

    background: var(--ks-bg);
    min-height: 100vh;
    max-width: 1200px;
    margin: 0 auto;
    margin-top: 72px;
    font-family: 'Inter', sans-serif;
  }

  /* SUB HERO */
  .sub-hero {
    padding: 48px 28px 44px;
    border-bottom: 0.5px solid var(--ks-border);
  }
  .sub-crumb {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ks-text-faint);
    margin-bottom: 24px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .sub-crumb .sep { color: rgba(240,240,236,0.12); }
  .sub-h {
    font-family: 'Syne', sans-serif;
    font-size: clamp(36px, 5.5vw, 58px);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -1.5px;
    color: var(--ks-text-primary);
    margin: 0;
  }
  .sub-h .accent-amber { color: var(--ks-amber); }
  .sub-tagline {
    font-size: 14px;
    color: var(--ks-text-muted);
    margin-top: 16px;
    max-width: 600px;
    line-height: 1.6;
  }

  /* SERVICE CARDS GRID */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 0.5px solid var(--ks-border);
  }
  @media (max-width: 768px) {
    .service-grid { grid-template-columns: 1fr; }
  }
  .svc-card {
    padding: 28px;
    border-right: 0.5px solid var(--ks-border);
    border-bottom: 0.5px solid var(--ks-border);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: background 0.2s;
  }
  .svc-card:hover { background: rgba(255,255,255,0.02); }
  .svc-card:nth-child(3n) { border-right: none; }
  @media (max-width: 768px) {
    .svc-card { border-right: none !important; }
  }
  
  .svc-title {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: var(--ks-text-primary);
    margin: 0 0 6px 0;
    line-height: 1.15;
  }
  .svc-one {
    font-size: 12px;
    color: rgba(240, 240, 236, 0.45);
    margin: 0;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .sub-hero { padding: 40px 16px 32px; }
    .svc-card { padding: 28px 16px; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initSocials() {
    gsap.fromTo(".hero-anim", 
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: "power2.out", delay: 0.15 }
    );
  }
  document.addEventListener("astro:page-load", initSocials);
</script>
