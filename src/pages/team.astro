---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { supabaseAdmin } from "../lib/supabase";

let teamAssets: any = {
  heading: "We bring a wealth of skills and experience from a wide range of backgrounds.",
  subtitle: "Our philosophy is simple; hire great people and give them the resources and support to do their best work.",
  members: [
    { name: "Jessica Dobrev", role: "Backend Lead", photo_url: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=600" },
    { name: "Drew Cano", role: "Head of UX", photo_url: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=600" },
    { name: "Sasha Kindred", role: "VP of Marketing", photo_url: "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&q=80&w=600" },
    { name: "Emily Donnavan", role: "Product Lead", photo_url: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=600" }
  ]
};

if (supabaseAdmin) {
  try {
    const { data } = await supabaseAdmin.from('site_config').select('data').eq('key', 'team_assets').single();
    if (data && data.data) {
      teamAssets = data.data;
    }
  } catch (e) {
    console.error("Failed to load team_assets:", e);
  }
}
---

<Layout title="Our Team — Kinbo" description="We bring a wealth of skills and experience from a wide range of backgrounds.">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" slot="head" />
  
  <div class="team-page">
    <div class="team-grid-lines"></div>

    <div class="team-container relative z-10">
      
      {/* 2x2 dot grid icon */}
      <div class="team-icon-wrapper">
        <div class="team-dot-grid">
          <span></span><span></span>
          <span></span><span></span>
        </div>
      </div>

      {/* Heading & Subtitle */}
      <div class="team-hero text-center">
        <h1 class="team-heading">{teamAssets.heading}</h1>
        <p class="team-subtitle">{teamAssets.subtitle}</p>
      </div>

      {/* Team Cards Grid */}
      <div class="members-grid">
        {teamAssets.members.map((member: any) => (
          <div class="member-card">
            <div class="member-image-container">
              {member.photo_url ? (
                <img src={member.photo_url} alt={member.name} class="member-image" loading="lazy" />
              ) : (
                <div class="member-image-placeholder">
                  <span>👤</span>
                </div>
              )}
            </div>
            
            {/* Float Card at bottom left */}
            <div class="member-details-overlay">
              <div class="member-details-box">
                <h3 class="member-name">{member.name}</h3>
                <p class="member-role">{member.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Join Us CTA */}
      <div class="team-cta">
        <div class="team-cta-box">
          <div class="team-cta-content">
            <h2 class="team-cta-title">Wanna join us?</h2>
            <p class="team-cta-desc">We are always looking for smart, ambitious, and autonomous thinkers to shape the next era of constraint-bound software systems.</p>
          </div>
          <a href="/apply" class="team-cta-btn">
            Apply Now
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .team-page {
    position: relative;
    background: #0a0a0c;
    min-height: 100vh;
    padding-top: 120px;
    padding-bottom: 120px;
    color: #f0f0ec;
    overflow-hidden: clip;
  }

  .team-grid-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-size: 50px 50px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-position: center top;
    mask-image: radial-gradient(circle at center, black, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at center, black, transparent 80%);
  }

  .team-container {
    max-w: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* 2x2 Dots Grid */
  .team-icon-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 32px;
  }

  .team-dot-grid {
    display: grid;
    grid-template-columns: repeat(2, 6px);
    gap: 6px;
  }

  .team-dot-grid span {
    width: 6px;
    height: 6px;
    background-color: #f0f0ec;
    border-radius: 1px;
    opacity: 0.85;
  }

  /* Hero Typography */
  .team-hero {
    max-w: 800px;
    margin: 0 auto 72px;
  }

  .team-heading {
    font-family: 'Syne', sans-serif;
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #f0f0ec;
    margin-bottom: 24px;
  }

  .team-subtitle {
    font-family: 'Lora', serif;
    font-size: 1.15rem;
    line-height: 1.6;
    color: rgba(240, 240, 236, 0.6);
    max-w: 600px;
    margin: 0 auto;
  }

  /* Grid Layout */
  .members-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 96px;
  }

  /* Responsive Grid */
  @media (max-width: 1024px) {
    .members-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .team-heading {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 640px) {
    .members-grid {
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 32px;
    }
    .team-heading {
      font-size: 1.75rem;
    }
  }

  /* Cards Styling */
  .member-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1 / 1.15;
    background: #111115;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .member-card:hover {
    transform: translateY(-4px);
    border-color: rgba(42, 157, 143, 0.3);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .member-image-container {
    width: 100%;
    height: 100%;
  }

  .member-image {
    width: 100%;
    height: 100%;
    object-cover: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .member-card:hover .member-image {
    transform: scale(1.03);
  }

  .member-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #141419;
    font-size: 2.5rem;
  }

  /* Float card overlay */
  .member-details-overlay {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    pointer-events: none;
  }

  .member-details-box {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 12px 16px;
    border-radius: 4px;
    width: fit-content;
    max-width: 90%;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .member-name {
    font-family: 'Syne', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0a0a0c;
    margin: 0;
    line-height: 1.2;
  }

  .member-role {
    font-family: 'Poppins', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(10, 10, 12, 0.6);
    margin: 4px 0 0;
    text-transform: capitalize;
  }

  /* CTA join us */
  .team-cta {
    margin-top: 120px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 64px;
  }

  .team-cta-box {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.015) 0%, rgba(255, 255, 255, 0.005) 100%);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    padding: 40px 48px;
    gap: 32px;
  }

  @media (max-width: 768px) {
    .team-cta-box {
      flex-direction: column;
      text-align: center;
      padding: 32px 24px;
    }
  }

  .team-cta-content {
    flex: 1;
  }

  .team-cta-title {
    font-family: 'Syne', sans-serif;
    font-size: 1.85rem;
    font-weight: 700;
    margin: 0 0 12px;
    color: #f0f0ec;
  }

  .team-cta-desc {
    font-family: 'Lora', serif;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(240, 240, 236, 0.5);
    margin: 0;
    max-w: 600px;
  }

  .team-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #2a9d8f;
    color: #0a0a0c;
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 14px 28px;
    border-radius: 30px;
    transition: all 0.3s ease;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(42, 157, 143, 0.2);
  }

  .team-cta-btn:hover {
    background-color: #35b0a2;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(42, 157, 143, 0.3);
  }
</style>
