---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
---

<Layout title="Terms & Conditions" description="Terms and Conditions for using the Dear & Co / Kinbo Technologies website and services.">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&display=swap" rel="stylesheet" slot="head" />
  <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet" slot="head" />

  <div class="ks-page">
    <!-- HERO -->
    <div class="sub-hero">
      <div class="sub-crumb hero-anim">
        HOME <span class="sep">/</span> <span style="color: var(--ks-teal);">TERMS</span>
      </div>
      <h1 class="sub-h hero-anim">Terms &<br><span class="accent-teal">Conditions.</span></h1>
      <p class="sub-tagline hero-anim">Last updated: May 2026. Please read these terms carefully before using our platform and services.</p>
    </div>

    <!-- TERMS SECTIONS -->
    <div class="info-section hero-anim">
      <div class="info-ghost-num">01</div>
      <h3 class="info-title">1. Introduction</h3>
      <div class="info-content">
        <p>Welcome to <strong>Dear & Co</strong> (powered by <strong>Kinbo Technologies Private Limited</strong>). By accessing or using our website, applications, or services, you agree to comply with and be bound by these Terms & Conditions. If you do not agree, please do not use our services.</p>
      </div>
    </div>

    <div class="info-section hero-anim">
      <div class="info-ghost-num">02</div>
      <h3 class="info-title">2. Intellectual Property</h3>
      <div class="info-content">
        <p>Unless otherwise stated, we own all intellectual property rights for the material, software, designs, and content on this website. All intellectual property rights are reserved. You are granted a limited license only for purposes of viewing and interacting with the services offered.</p>
      </div>
    </div>

    <div class="info-section hero-anim">
      <div class="info-ghost-num">03</div>
      <h3 class="info-title">3. Prohibited Activities</h3>
      <div class="info-content">
        <p>You are specifically restricted from all of the following:</p>
        <ul class="info-list">
          <li>Publishing any website material in any other media without prior consent.</li>
          <li>Selling, sublicensing, or commercializing any website content.</li>
          <li>Using this website in any way that is or may be damaging to the site's integrity or performance.</li>
          <li>Engaging in any data mining, data harvesting, data extracting, or scraping.</li>
        </ul>
      </div>
    </div>

    <div class="info-section hero-anim">
      <div class="info-ghost-num">04</div>
      <h3 class="info-title">4. Limitation of Liability</h3>
      <div class="info-content">
        <p>Our website and services are provided "as is," with all faults, and we express no representations or warranties of any kind. Kinbo Technologies Private Limited and its officers shall not be held liable for any indirect, consequential, or special liability arising out of or in any way related to your use of this website.</p>
      </div>
    </div>

    <div class="info-section hero-anim">
      <div class="info-ghost-num">05</div>
      <h3 class="info-title">5. Governing Law</h3>
      <div class="info-content">
        <p>These terms will be governed by and interpreted in accordance with the laws of India, and you submit to the non-exclusive jurisdiction of the state and federal courts located in India for the resolution of any disputes.</p>
      </div>
    </div>

    <!-- BOTTOM BAR -->
    <div class="sub-bottom">
      <div class="flex flex-col gap-1">
        <span class="font-mono text-xs text-teal uppercase tracking-[0.15em] mb-2">Need Help?</span>
        <p class="sub-bottom-statement" style="font-size: 20px;">Questions about our Terms?</p>
        <span class="text-[11px] text-[var(--ks-text-muted)] mt-2 font-mono">Our team is here to clarify.</span>
      </div>
      <a href="/chat" class="sub-cta-btn sub-cta-btn--teal">Contact Support →</a>
    </div>
  </div>
</Layout>

<style>
  .ks-page {
    --ks-bg: #0a0a0c;
    --ks-surface: #0f1117;
    --ks-border: rgba(255, 255, 255, 0.07);
    --ks-text-primary: #f0f0ec;
    --ks-text-muted: rgba(240, 240, 236, 0.40);
    --ks-text-faint: rgba(240, 240, 236, 0.6);
    --ks-label: rgba(240, 240, 236, 0.7);
    --ks-teal: #2dd4bf;
    --ks-teal-bg: rgba(45, 212, 191, 0.08);
    --ks-teal-border: rgba(45, 212, 191, 0.22);

    background: var(--ks-bg);
    min-height: 100vh;
    max-width: 1200px;
    margin: 0 auto;
    margin-top: 72px;
    font-family: 'Inter', sans-serif;
  }

  /* SUB HERO */
  .sub-hero {
    padding: 48px 28px 44px;
    border-bottom: 0.5px solid var(--ks-border);
  }
  .sub-crumb {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ks-text-faint);
    margin-bottom: 24px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .sub-crumb .sep { color: rgba(240,240,236,0.12); }
  .sub-h {
    font-family: 'Syne', sans-serif;
    font-size: clamp(36px, 5.5vw, 58px);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -1.5px;
    color: var(--ks-text-primary);
    margin: 0;
  }
  .sub-h .accent-teal { color: var(--ks-teal); }
  .sub-tagline {
    font-size: 14px;
    color: var(--ks-text-muted);
    margin-top: 16px;
    max-width: 600px;
    line-height: 1.6;
  }

  /* INFO SECTIONS */
  .info-section {
    padding: 44px 28px;
    border-bottom: 0.5px solid var(--ks-border);
    position: relative;
    overflow: hidden;
  }
  .info-ghost-num {
    font-family: 'Syne', sans-serif;
    font-size: 80px;
    font-weight: 800;
    line-height: 1;
    position: absolute;
    top: 10px;
    right: 20px;
    color: var(--ks-teal);
    opacity: 0.03;
    letter-spacing: -4px;
    pointer-events: none;
    user-select: none;
  }
  .info-title {
    font-family: 'Syne', sans-serif;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--ks-text-primary);
    margin-bottom: 20px;
  }
  .info-content {
    font-size: 13px;
    color: var(--ks-text-muted);
    line-height: 1.7;
    max-width: 680px;
  }
  .info-content p {
    margin-bottom: 16px;
  }
  .info-list {
    list-style: none;
    padding-left: 0;
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .info-list li {
    padding-left: 20px;
    position: relative;
  }
  .info-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--ks-teal);
    font-family: monospace;
    opacity: 0.7;
  }
  .info-list strong {
    color: var(--ks-text-primary);
    font-weight: 500;
  }

  /* BOTTOM BAR */
  .sub-bottom {
    padding: 32px 28px;
    border-bottom: 0.5px solid var(--ks-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .sub-bottom-statement {
    font-family: 'Syne', sans-serif;
    font-size: clamp(18px, 3vw, 22px);
    font-weight: 800;
    letter-spacing: -0.5px;
    color: rgba(240, 240, 236, 0.85);
    line-height: 1.1;
    margin: 0;
  }
  .sub-cta-btn {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: 4px;
    text-decoration: none;
    border: 0.5px solid;
    background: none;
    transition: opacity 0.18s;
    white-space: nowrap;
  }
  .sub-cta-btn:hover { opacity: 0.65; }
  .sub-cta-btn--teal { color: var(--ks-teal); border-color: var(--ks-teal-border); }

  @media (max-width: 640px) {
    .sub-hero { padding: 40px 16px 32px; }
    .info-section { padding: 32px 16px; }
    .sub-bottom { padding: 32px 16px; flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initTerms() {
    gsap.fromTo(".hero-anim", 
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: "power2.out", delay: 0.15 }
    );
  }
  document.addEventListener("astro:page-load", initTerms);
</script>
